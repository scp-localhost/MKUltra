# MKUltra — .gitignore
# Generated: 2026-05-08 | Node: Rat Dev / Mause König
# Decisions documented in CHECKPOINT_20260508.md §5
# ─────────────────────────────────────────────────────────────────────────────

# ── Python ────────────────────────────────────────────────────────────────────

__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.venv/
venv/
.env
*.egg-info/
dist/
build/

# ── Artifacts (Decision 1) ────────────────────────────────────────────────────
# Large reference PDFs and images tracked by directory stub only.
# If git-lfs is adopted later, remove these lines and lfs-track instead.

artifacts/*.pdf
artifacts/*.webp
artifacts/*.png
artifacts/*.jpg
artifacts/*.jpeg

# ── Live session data (Decision 2) ───────────────────────────────────────────
# bsi_sessions/ contains potentially sensitive live trial output.
# Directory structure preserved via .gitkeep.

data/bsi_sessions/*.csv
data/bsi_sessions/*.json

# ── Raw experimental data (Decision 3) ───────────────────────────────────────
# data/raw/ is pre-positioned for live experimental data collection.
# Nothing lives here yet; exclude everything when it does.
# Directory preserved via .gitkeep.

data/raw/*
!data/raw/.gitkeep

# ── Synthetic validation output ───────────────────────────────────────────────
# sap_synthetic_output.csv is generated by sap_pipeline_validation.py.
# Committed copy serves as a pipeline reference snapshot — keep it.
# Future re-runs overwrite locally but the committed version is the baseline.
# Uncomment the line below only if you want to exclude it entirely.

# data/synthetic/sap_synthetic_output.csv

# ── Legacy binary drafts (Decision 4) ────────────────────────────────────────
# .docx files in drafts/ are superseded by canonical .md files.
# Exclude globally. If a specific .docx must be tracked, use:
#   git add -f drafts/paper2/specific_file.docx

*.docx
*.doc

# ── Analysis generated outputs (Decision 5) ──────────────────────────────────
# analysis/ subdirs hold generated charts, model outputs, and result CSVs
# from live data runs. Directory structure preserved via .gitkeep.

analysis/anova/*
analysis/lmm/*
analysis/sensitivity/*
!analysis/anova/.gitkeep
!analysis/lmm/.gitkeep
!analysis/sensitivity/.gitkeep

# Catch generated output types anywhere under analysis/
analysis/**/*.png
analysis/**/*.csv
analysis/**/*.json
analysis/**/*.html
analysis/**/*.pkl
analysis/**/*.rds
analysis/**/*.RData

# ── Editor and OS noise ───────────────────────────────────────────────────────

.DS_Store
Thumbs.db
desktop.ini
~$*.docx
~$*.xlsx
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ── Jupyter ───────────────────────────────────────────────────────────────────

.ipynb_checkpoints/
*.ipynb

# ── Outputs directory (if used locally) ──────────────────────────────────────
# Local scratch outputs from Claude/swarm sessions — not repo content.

outputs/

# ── Notes: what IS tracked ───────────────────────────────────────────────────
# Everything not excluded above is tracked. Key tracked items:
#
# scripts/*.py                    all production scripts
# scripts/_archive/*.py           archived monoliths (provenance preservation)
# docs/*.md                       data_dictionary, SERIES_BIBLIOGRAPHY, SAP v1.2
# docs/*.json                     stimuli_registry
# docs/*.bib                      Mouton bib file
# docs/_archive/*.md              stale maps (historical record)
# drafts/**/*.md                  all section files and rewrite drafts
# drafts/SERIES_DRAFT_INDEX.md
# seeds/_archive/*.md             seed provenance
# artifacts/                      directory stub only (no binary files)
# data/synthetic/sap_synthetic_output.csv   pipeline validation baseline
# data/bsi_sessions/              directory stub only
# data/raw/                       directory stub only
# analysis/anova/                 directory stub only
# analysis/lmm/                   directory stub only
# analysis/sensitivity/           directory stub only
# README.md
# .gitignore                      this file
